% 整体研究思路，黑白框图
\begin{tikzpicture}[
  font=\small,
  box/.style={draw=black,thick,fill=white,align=center,text width=49mm,minimum height=12mm,inner sep=3pt},
  head/.style={draw=black,thick,fill=white,align=center,text width=132mm,minimum height=12mm,inner sep=3pt},
  arr/.style={-{Stealth[length=2mm]},thick,black}
]
\node[head] (title) {面向大语言模型检索增强生成系统的安全攻防研究};
\node[box,below=9mm of title,xshift=-36mm] (a0) {研究点一：基于多文本分块协同的\\组合式投毒攻击框架};
\node[box,below=9mm of title,xshift=36mm] (d0) {研究点二：基于检索上下文表征分析的\\检索增强生成安全防御方法};
\node[box,below=5mm of a0] (a1) {单一源文档构造\\互补前提与内容布局};
\node[box,below=5mm of a1] (a2) {受害者侧分块\\角色保持与联合召回};
\node[box,below=5mm of a2] (a3) {离散候选搜索\\分级评价与预算调度};
\node[box,below=5mm of a3] (a4) {组合对照与完整上下文\\检索、生成效果评价};
\node[box,below=5mm of d0] (d1) {局部与结构分析\\组合候选及探索抽样};
\node[box,below=5mm of d1] (d2) {组合影响审查\\正常多跳分布校准};
\node[box,below=5mm of d2] (d3) {证据选择与上下文修复\\桥接证据保护及复查};
\node[box,below=5mm of d3] (d4) {攻击抑制与效用评价\\误报、覆盖率及开销};
\node[head,below=10mm of $(a4.south)!0.5!(d4.south)$] (eval) {统一实验环境与评价协议\\数据划分、源文档标识、分块记录、独立查询统计};
\node[head,below=6mm of eval] (system) {RAG投毒攻防联合测试系统};
\draw[arr] (title.south) -- ++(0,-4mm) -| (a0.north);
\draw[arr] (title.south) -- ++(0,-4mm) -| (d0.north);
\foreach \u/\v in {a0/a1,a1/a2,a2/a3,a3/a4,d0/d1,d1/d2,d2/d3,d3/d4}{\draw[arr] (\u.south)--(\v.north);}
\draw[arr,dashed] (a2.east) -- node[above,font=\scriptsize,align=center]{攻击样本} (d2.west);
\draw[arr] (a4.south) -- ++(0,-4mm) -| (eval.north);
\draw[arr] (d4.south) -- ++(0,-4mm) -| (eval.north);
\draw[arr] (eval.south) -- (system.north);
\end{tikzpicture}
