% 研究点二：基于检索上下文表征分析的检索增强生成安全防御方法流程，黑白框图
\begin{tikzpicture}[
  font=\small,
  box/.style={draw=black,thick,fill=white,align=center,text width=44mm,minimum height=11mm,inner sep=3pt},
  half/.style={draw=black,thick,fill=white,align=center,text width=69mm,minimum height=11mm,inner sep=3pt},
  wide/.style={draw=black,thick,fill=white,align=center,text width=144mm,minimum height=10mm,inner sep=3pt},
  stage/.style={draw=black,dashed,inner sep=4mm},
  lab/.style={font=\footnotesize\bfseries,fill=white,inner sep=1pt},
  arr/.style={-{Stealth[length=2mm]},thick,black}
]
\node[wide] (input) {输入：查询$q$、Top-$K$候选文本块、拟合集$\mathcal D_{\mathrm{fit}}$参数与校准集$\mathcal D_{\mathrm{cal}}$查询级阈值};
% 阶段一
\node[half,below=12mm of input,xshift=-37.5mm] (dyn) {单块检索统计筛选\\$s_{\mathrm{tail}}$、$\tau_{\mathrm{svd}}$、$\rho_{\mathrm{tan}}$、$d_{\mathrm{intra}}$与$A(q,c_i)$\\查询级校准：$M_j=\max_i A(q_j,c_{j,i})$};
\node[half,below=12mm of input,xshift=37.5mm] (str) {保留块$\mathcal C_{\mathrm{surv}}$跨块关系检查\\构建上下文实体—命题多重图\\检查$\Phi_{\mathrm{prov}}$、$\Phi_{\mathrm{bridge}}$、$\Phi_{\mathrm{conflict}}$};
\node[box,below=12mm of $(dyn.south)!0.5!(str.south)$] (gray) {待审集$\mathcal S_{\mathrm{judge}}$\\$\tau_{\mathrm{low}}<A(q,c_i)\le\tau_{\mathrm{high}}$\\或触发成对检查指标};
\node[box,left=6mm of gray] (red) {剔除\\$A(q,c_i)>\tau_{\mathrm{high}}$};
\node[box,right=6mm of gray] (green) {保留且未触发待审\\$A(q,c_i)\le\tau_{\mathrm{low}}$\\且未触发成对检查指标};
\node[stage,fit=(dyn)(str)(red)(green)] (st1) {};
\node[lab,anchor=west] at ([xshift=3mm]st1.north west) {阶段一：统计筛选与跨块关系检查};
\draw[arr] (input.south) -- ++(0,-4mm) -| (dyn.north);
\draw[arr] (dyn.east) -- node[above,font=\scriptsize]{$A\le\tau_{\mathrm{high}}$} (str.west);
\draw[arr] (dyn.south) -- ++(0,-4mm) -| (red.north);
\draw[arr] (dyn.south) -- ++(0,-4mm) -| ([xshift=-8mm]gray.north);
\draw[arr] (str.south) -- ++(0,-4mm) -| ([xshift=8mm]gray.north);
\draw[arr] (str.south) -- ++(0,-4mm) -| (green.north);
% 阶段二
\node[box,below=14mm of gray] (j2) {LLM复核\\命题、跨块关系、参照文本};
\node[box,left=6mm of j2] (j1) {选择其他来源参照文本\\非待审保留块中来源不同者};
\node[box,right=6mm of j2] (j3) {移除判为投毒的块\\输出净化上下文};
\node[stage,fit=(j1)(j3)] (st2) {};
\node[lab,anchor=west] at ([xshift=3mm]st2.north west) {阶段二：对待审块调用LLM复核};
\draw[arr] (gray.south) -- (j2.north);
\draw[arr] (j1.east) -- (j2.west);
\draw[arr] (j2.east) -- (j3.west);
% 输出
\node[wide,below=10mm of st2] (out) {输出过滤后上下文$\mathcal C^*$，交由生成模型生成回答};
\draw[arr] (j3.south) -- ++(0,-6.5mm) -| (out.north);
\draw[arr] (green.east) -- ++(4mm,0) |- (out.east);
\end{tikzpicture}
