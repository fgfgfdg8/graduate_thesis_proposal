% AgentCanary数据集分布图：上方两张饼图，下方柱状图
% 左图：各风险入口任务占比（496个seed tasks）
% 右图：风险影响类别分布
% 下方：12个模型总体安全性评分分布条形图
% 编译方式：XeLaTeX + tikz（颜色定义见 figures/tikz_styles.tex）
\begin{tikzpicture}[x=1cm, y=1cm]

% ===== 左图：风险入口占比（496个） =====
% DPI: 46/496=9.3%, IPI: 181/496=36.5%, MC: 104/496=21.0%,
% SP: 110/496=22.2%, IF: 55/496=11.1%

\def\cx{4.0}
\def\cy{3.5}
\def\r{2.4}

% IPI: 90° to -41.4° (131.4°)
\fill[pieGreen!80] (\cx,\cy) -- ++(90:\r) arc[start angle=90, end angle=-41.4, radius=\r] -- cycle;
% SP: -41.4° to -121.3° (79.9°)
\fill[piePurple!80] (\cx,\cy) -- ++(-41.4:\r) arc[start angle=-41.4, end angle=-121.3, radius=\r] -- cycle;
% MC: -121.3° to -196.9° (75.6°)
\fill[pieOrange!80] (\cx,\cy) -- ++(-121.3:\r) arc[start angle=-121.3, end angle=-196.9, radius=\r] -- cycle;
% IF: -196.9° to -236.9° (40.0°)
\fill[pieTeal!80] (\cx,\cy) -- ++(-196.9:\r) arc[start angle=-196.9, end angle=-236.9, radius=\r] -- cycle;
% DPI: -236.9° to -270° (33.1°)
\fill[pieBlue!80] (\cx,\cy) -- ++(-236.9:\r) arc[start angle=-236.9, end angle=-270, radius=\r] -- cycle;

\draw[white, line width=1.2pt] (\cx,\cy) -- ++(90:\r);
\draw[white, line width=1.2pt] (\cx,\cy) -- ++(-41.4:\r);
\draw[white, line width=1.2pt] (\cx,\cy) -- ++(-121.3:\r);
\draw[white, line width=1.2pt] (\cx,\cy) -- ++(-196.9:\r);
\draw[white, line width=1.2pt] (\cx,\cy) -- ++(-236.9:\r);

% 标注
\node[font=\small\bfseries, text=white] at ({\cx + 1.6*cos(24.3)}, {\cy + 1.6*sin(24.3)}) {36.5\%};
\node[font=\small\bfseries, text=white] at ({\cx + 1.6*cos(-81.35)}, {\cy + 1.6*sin(-81.35)}) {22.2\%};
\node[font=\small\bfseries, text=white] at ({\cx + 1.6*cos(-159.1)}, {\cy + 1.6*sin(-159.1)}) {21.0\%};
\node[font=\small\bfseries, text=white] at ({\cx + 1.6*cos(-216.9)}, {\cy + 1.6*sin(-216.9)}) {11.1\%};
\node[font=\small\bfseries, text=white] at ({\cx + 1.6*cos(-253.45)}, {\cy + 1.6*sin(-253.45)}) {9.3\%};

% 图例
\node[font=\footnotesize\bfseries] at (\cx, 7.0) {风险入口类型分布（共496个）};
\fill[pieGreen!80]  (1.25,0.55) rectangle (1.75,0.92); \node[font=\footnotesize, anchor=west] at (1.88,0.735) {IPI（181个）};
\fill[piePurple!80] (1.25,0.05) rectangle (1.75,0.42); \node[font=\footnotesize, anchor=west] at (1.88,0.235) {SP（110个）};
\fill[pieOrange!80] (4.25,0.55) rectangle (4.75,0.92); \node[font=\footnotesize, anchor=west] at (4.88,0.735) {MC（104个）};
\fill[pieTeal!80]   (4.25,0.05) rectangle (4.75,0.42); \node[font=\footnotesize, anchor=west] at (4.88,0.235) {IF（55个）};
\fill[pieBlue!80]   (6.75,0.55) rectangle (7.25,0.92); \node[font=\footnotesize, anchor=west] at (7.38,0.735) {DPI（46个）};

% ===== 右图：风险影响类别分布 =====
\def\cx{10.5}
\def\cy{3.5}

% Simplified: I(Local)+II(Data) ≈ 40%, III(Persistent State) ≈ 20%, IV(Privilege) ≈ 15%, V(Network) ≈ 10%, VI(Business)+VII(Financial) ≈ 15%
\fill[pieGreen!80] (\cx,\cy) -- ++(90:\r) arc[start angle=90, end angle=-54, radius=\r] -- cycle;
\fill[pieOrange!80] (\cx,\cy) -- ++(-54:\r) arc[start angle=-54, end angle=-126, radius=\r] -- cycle;
\fill[pieBlue!80] (\cx,\cy) -- ++(-126:\r) arc[start angle=-126, end angle=-180, radius=\r] -- cycle;
\fill[pieRed!80] (\cx,\cy) -- ++(-180:\r) arc[start angle=-180, end angle=-216, radius=\r] -- cycle;
\fill[piePurple!80] (\cx,\cy) -- ++(-216:\r) arc[start angle=-216, end angle=-270, radius=\r] -- cycle;

\draw[white, line width=1.2pt] (\cx,\cy) -- ++(90:\r);
\draw[white, line width=1.2pt] (\cx,\cy) -- ++(-54:\r);
\draw[white, line width=1.2pt] (\cx,\cy) -- ++(-126:\r);
\draw[white, line width=1.2pt] (\cx,\cy) -- ++(-180:\r);
\draw[white, line width=1.2pt] (\cx,\cy) -- ++(-216:\r);

\node[font=\small\bfseries, text=white] at ({\cx+1.5*cos(18)}, {\cy+1.5*sin(18)}) {I+II};
\node[font=\small\bfseries, text=white] at ({\cx+1.5*cos(-90)}, {\cy+1.5*sin(-90)}) {III};
\node[font=\small\bfseries, text=white] at ({\cx+1.5*cos(-153)}, {\cy+1.5*sin(-153)}) {IV};
\node[font=\small\bfseries, text=white] at ({\cx+1.5*cos(-198)}, {\cy+1.5*sin(-198)}) {V};
\node[font=\small\bfseries, text=white] at ({\cx+1.5*cos(-243)}, {\cy+1.5*sin(-243)}) {VI+VII};

% 图例
\node[font=\footnotesize\bfseries] at (\cx, 7.0) {风险影响类别分布};
\fill[pieGreen!80]  (7.75,0.75) rectangle (8.20,1.05); \node[font=\footnotesize, anchor=west] at (8.32,0.90) {I+II 环境与数据};
\fill[pieOrange!80] (7.75,0.35) rectangle (8.20,0.65); \node[font=\footnotesize, anchor=west] at (8.32,0.50) {III 持久状态};
\fill[pieBlue!80]   (7.75,-0.05) rectangle (8.20,0.25); \node[font=\footnotesize, anchor=west] at (8.32,0.10) {IV 权限控制};
\fill[pieRed!80]    (10.50,0.75) rectangle (10.95,1.05); \node[font=\footnotesize, anchor=west] at (11.07,0.90) {V 网络攻击};
\fill[piePurple!80] (10.50,0.35) rectangle (10.95,0.65); \node[font=\footnotesize, anchor=west] at (11.07,0.50) {VI+VII 业务与金融};

% ===== 下方：12个模型总体评分分布 =====
% Data from AgentCanary Table 6 (Overall Score, OpenClaw framework)
% GLM-4.7-Flash 37.9, Qwen3.5-35B 43.9, MiniMax-M2.5 43.9, 
% Kimi-K2.5 46.6, Qwen3.5-122B 52.0, DeepSeek-V4-Pro 54.4,
% Qwen3.5-397B 57.2, Claude Sonnet 4.5 61.9, GLM-5 64.7,
% GPT-5.4 68.5, Qwen3.6-Plus 69.7, Claude Opus 4.6 83.9

\def\bx{0.5}
\def\by{-8.5}
\def\bh{5.0}

\draw[->, line width=0.8pt, agentGray] (\bx, \by) -- (\bx, {\by+\bh+0.8});
\draw[->, line width=0.8pt, agentGray] (\bx, \by) -- ({\bx+14.5}, \by);
\node[font=\footnotesize, rotate=90, anchor=south, text=agentGray] at ({\bx-0.75}, {\by+\bh/2}) {总体安全性评分};

\foreach \v/\lbl in {0/0, 1.25/25, 2.5/50, 3.75/75, 5.0/100} {
  \draw[agentGray, line width=0.4pt, dashed] (\bx, {\by+\v}) -- ({\bx+14.2}, {\by+\v});
  \node[font=\tiny, anchor=east, text=agentGray] at ({\bx-0.1}, {\by+\v}) {\lbl};
}

% 50分参考线
\draw[pieRed, line width=0.8pt, dashed] (\bx, {\by+2.5}) -- ({\bx+14.2}, {\by+2.5});
\node[font=\tiny, text=pieRed, anchor=west] at ({\bx+14.2}, {\by+2.5}) {50};

\def\bw{0.85}
\def\bs{1.10}

% Sorted by Overall Score ascending
\fill[pieRed!80] ({\bx+0*\bs+0.15}, \by) rectangle ({\bx+0*\bs+0.15+\bw}, {\by+37.9/100*\bh});
\node[font=\tiny, rotate=60, anchor=east] at ({\bx+0*\bs+0.15+\bw/2}, {\by-0.15}) {GLM-4.7F};
\node[font=\tiny\bfseries, text=pieRed] at ({\bx+0*\bs+0.15+\bw/2}, {\by+37.9/100*\bh+0.22}) {37.9};

\fill[pieOrange!80] ({\bx+1*\bs+0.15}, \by) rectangle ({\bx+1*\bs+0.15+\bw}, {\by+43.9/100*\bh});
\node[font=\tiny, rotate=60, anchor=east] at ({\bx+1*\bs+0.15+\bw/2}, {\by-0.15}) {Qw3.5-35B};
\node[font=\tiny\bfseries, text=pieOrange] at ({\bx+1*\bs+0.15+\bw/2}, {\by+43.9/100*\bh+0.22}) {43.9};

\fill[pieOrange!80] ({\bx+2*\bs+0.15}, \by) rectangle ({\bx+2*\bs+0.15+\bw}, {\by+43.9/100*\bh});
\node[font=\tiny, rotate=60, anchor=east] at ({\bx+2*\bs+0.15+\bw/2}, {\by-0.15}) {MM-M2.5};
\node[font=\tiny\bfseries, text=pieOrange] at ({\bx+2*\bs+0.15+\bw/2}, {\by+43.9/100*\bh+0.22}) {43.9};

\fill[pieOrange!80] ({\bx+3*\bs+0.15}, \by) rectangle ({\bx+3*\bs+0.15+\bw}, {\by+46.6/100*\bh});
\node[font=\tiny, rotate=60, anchor=east] at ({\bx+3*\bs+0.15+\bw/2}, {\by-0.15}) {Kimi-K2.5};
\node[font=\tiny\bfseries, text=pieOrange] at ({\bx+3*\bs+0.15+\bw/2}, {\by+46.6/100*\bh+0.22}) {46.6};

\fill[pieOrange!80] ({\bx+4*\bs+0.15}, \by) rectangle ({\bx+4*\bs+0.15+\bw}, {\by+52.0/100*\bh});
\node[font=\tiny, rotate=60, anchor=east] at ({\bx+4*\bs+0.15+\bw/2}, {\by-0.15}) {Qw3.5-122B};
\node[font=\tiny\bfseries, text=pieOrange] at ({\bx+4*\bs+0.15+\bw/2}, {\by+52.0/100*\bh+0.22}) {52.0};

\fill[pieOrange!80] ({\bx+5*\bs+0.15}, \by) rectangle ({\bx+5*\bs+0.15+\bw}, {\by+54.4/100*\bh});
\node[font=\tiny, rotate=60, anchor=east] at ({\bx+5*\bs+0.15+\bw/2}, {\by-0.15}) {DS-V4-Pro};
\node[font=\tiny\bfseries, text=pieOrange] at ({\bx+5*\bs+0.15+\bw/2}, {\by+54.4/100*\bh+0.22}) {54.4};

\fill[pieOrange!80] ({\bx+6*\bs+0.15}, \by) rectangle ({\bx+6*\bs+0.15+\bw}, {\by+57.2/100*\bh});
\node[font=\tiny, rotate=60, anchor=east] at ({\bx+6*\bs+0.15+\bw/2}, {\by-0.15}) {Qw3.5-397B};
\node[font=\tiny\bfseries, text=pieOrange] at ({\bx+6*\bs+0.15+\bw/2}, {\by+57.2/100*\bh+0.22}) {57.2};

\fill[pieOrange!80] ({\bx+7*\bs+0.15}, \by) rectangle ({\bx+7*\bs+0.15+\bw}, {\by+61.9/100*\bh});
\node[font=\tiny, rotate=60, anchor=east] at ({\bx+7*\bs+0.15+\bw/2}, {\by-0.15}) {Sonnet4.5};
\node[font=\tiny\bfseries, text=pieOrange] at ({\bx+7*\bs+0.15+\bw/2}, {\by+61.9/100*\bh+0.22}) {61.9};

\fill[pieGreen!80] ({\bx+8*\bs+0.15}, \by) rectangle ({\bx+8*\bs+0.15+\bw}, {\by+64.7/100*\bh});
\node[font=\tiny, rotate=60, anchor=east] at ({\bx+8*\bs+0.15+\bw/2}, {\by-0.15}) {GLM-5};
\node[font=\tiny\bfseries, text=pieGreen] at ({\bx+8*\bs+0.15+\bw/2}, {\by+64.7/100*\bh+0.22}) {64.7};

\fill[pieGreen!80] ({\bx+9*\bs+0.15}, \by) rectangle ({\bx+9*\bs+0.15+\bw}, {\by+68.5/100*\bh});
\node[font=\tiny, rotate=60, anchor=east] at ({\bx+9*\bs+0.15+\bw/2}, {\by-0.15}) {GPT-5.4};
\node[font=\tiny\bfseries, text=pieGreen] at ({\bx+9*\bs+0.15+\bw/2}, {\by+68.5/100*\bh+0.22}) {68.5};

\fill[pieGreen!80] ({\bx+10*\bs+0.15}, \by) rectangle ({\bx+10*\bs+0.15+\bw}, {\by+69.7/100*\bh});
\node[font=\tiny, rotate=60, anchor=east] at ({\bx+10*\bs+0.15+\bw/2}, {\by-0.15}) {Qw3.6-Plus};
\node[font=\tiny\bfseries, text=pieGreen] at ({\bx+10*\bs+0.15+\bw/2}, {\by+69.7/100*\bh+0.22}) {69.7};

\fill[pieGreen!80] ({\bx+11*\bs+0.15}, \by) rectangle ({\bx+11*\bs+0.15+\bw}, {\by+83.9/100*\bh});
\node[font=\tiny, rotate=60, anchor=east] at ({\bx+11*\bs+0.15+\bw/2}, {\by-0.15}) {Opus4.6};
\node[font=\tiny\bfseries, text=pieGreen] at ({\bx+11*\bs+0.15+\bw/2}, {\by+83.9/100*\bh+0.22}) {83.9};

\node[font=\footnotesize\bfseries] at ({\bx+6.8}, {\by+\bh+1.1}) {12个主流模型在AgentCanary上的总体安全性评分分布（OpenClaw框架）};

% 颜色图例
\fill[pieRed!80]    (1.10,{\by-2.18}) rectangle (1.53,{\by-1.88}); \node[font=\tiny, anchor=west] at (1.70,{\by-2.03}) {低安全（$<$50）};
\fill[pieOrange!80] (4.60,{\by-2.18}) rectangle (5.03,{\by-1.88}); \node[font=\tiny, anchor=west] at (5.20,{\by-2.03}) {中等（50--64）};
\fill[pieGreen!80]  (8.80,{\by-2.18}) rectangle (9.23,{\by-1.88}); \node[font=\tiny, anchor=west] at (9.40,{\by-2.03}) {较高（$\geq$65）};

\end{tikzpicture}
