% 整体研究思路，黑白框图
\begin{tikzpicture}[
  font=\small,
  box/.style={draw=black,thick,fill=white,align=center,text width=58mm,minimum height=11mm,inner sep=3pt},
  rp/.style={draw=black,very thick,fill=white,align=center,text width=58mm,minimum height=16mm,inner sep=3pt},
  head/.style={draw=black,thick,fill=white,align=center,text width=144mm,minimum height=11mm,inner sep=3pt},
  prob/.style={draw=black,dashed,fill=white,align=center,text width=58mm,minimum height=10mm,inner sep=3pt,font=\footnotesize},
  arr/.style={-{Stealth[length=2mm]},thick,black}
]
\node[head] (title) {\textbf{面向大语言模型检索增强生成系统的安全攻防研究}\\核心问题：文档级摄入与块级检索之间的粒度差};
\node[prob,below=8mm of title,xshift=-43mm] (pa) {攻击侧：已引述的单文档方法由单个文本\\承载完整攻击逻辑，本文考察同源文本块的信息分工};
\node[prob,below=8mm of title,xshift=43mm] (pd) {防御侧：现有方法依据的信号各异，本文关注\\同源跨块下的检测、桥接证据保留与开销};
\node[rp,below=7mm of pa] (a0) {\textbf{研究点一}\\基于同源多文本块协同的\\分布式投毒攻击框架};
\node[rp,below=7mm of pd] (d0) {\textbf{研究点二}\\基于检索上下文表征分析的\\检索增强生成安全防御方法};
\node[box,below=5mm of a0] (a1) {单源威胁模型与问题形式化\\共同检索与目标答案生成};
\node[box,below=5mm of a1] (a2) {阶段一：构造双块载荷\\插入位置、背景句、组合检验$\mathcal V_{\mathrm{comp}}$};
\node[box,below=5mm of a2] (a3) {阶段二：检索触发器优化\\跨视图检索损失、交替优化};
\node[box,below=5mm of d0] (d1) {服务端防御目标\\检测、证据保留与延迟约束};
\node[box,below=5mm of d1] (d2) {阶段一：统计筛选与跨块关系检查\\查询级阈值校准与实体—命题多重图};
\node[box,below=5mm of d2] (d3) {阶段二：对待审块调用LLM\\结合其他来源参照文本检查并过滤};
\node[head,below=10mm of $(a3.south)!0.5!(d3.south)$] (eval) {统一实验环境与评价协议};
\node[head,below=6mm of eval] (system) {RAG投毒攻防联合测试系统};
\draw[arr] (title.south) -- ++(0,-3mm) -| (pa.north);
\draw[arr] (title.south) -- ++(0,-3mm) -| (pd.north);
\foreach \u/\v in {pa/a0,pd/d0,a0/a1,a1/a2,a2/a3,d0/d1,d1/d2,d2/d3}{\draw[arr] (\u.south)--(\v.north);}
\draw[arr,dashed] (a3.east) -- node[above,font=\scriptsize,align=center]{组合式}node[below,font=\scriptsize,align=center]{攻击样本} (d3.west);
\draw[arr,dashed] (a0.east) -- node[above,font=\scriptsize]{检测对象} (d0.west);
\draw[arr] (a3.south) -- ++(0,-4mm) -| (eval.north);
\draw[arr] (d3.south) -- ++(0,-4mm) -| (eval.north);
\draw[arr] (eval.south) -- (system.north);
\end{tikzpicture}