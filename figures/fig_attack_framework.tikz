% 研究点一：两阶段解耦的跨块组合式投毒攻击框架，黑白框图
\begin{tikzpicture}[
  font=\small,
  box/.style={draw=black,thick,fill=white,align=center,text width=44mm,minimum height=11mm,inner sep=3pt},
  wide/.style={draw=black,thick,fill=white,align=center,text width=144mm,minimum height=10mm,inner sep=3pt},
  stage/.style={draw=black,dashed,inner sep=4mm},
  lab/.style={font=\footnotesize\bfseries,fill=white,inner sep=1pt},
  arr/.style={-{Stealth[length=2mm]},thick,black}
]
\node[wide] (input) {输入：查询$q$、正确答案$y_{\mathrm{true}}$、目标答案$a^*$、载体长文档$D$、影子背景Top-$K$缓存$C_{\mathrm{clean}}^{-d,s}(q)$与中性替代块$N_A,N_B$};
% 阶段一
\node[box,below=12mm of input] (s2) {核心载荷与语义垫片\\$\mathcal P_A$：规则注入块\\$\mathcal P_B$：实例桥接块};
\node[box,left=6mm of s2] (s1) {两步槽位锚定与校验\\段落预筛与跨度复核\\核心间距$\ge\gamma K_{\max}$};
\node[box,right=6mm of s2] (s3) {固定背景$B_0$受控上下文\\$C_{00},C_{10},C_{01},C_{11}$\\容量恒为$K$且背景一致};
\node[wide,below=6mm of s2] (gate) {受控组合生成判据$\mathcal V_{\mathrm{comp}}$：相同背景$B_0$下$C_{00},C_{10},C_{01}$均输出非目标响应\ \ $\land$\ \ 双块$C_{11}=[B_0,c_A,c_B]$命中$a^*$};
\node[stage,fit=(s1)(s3)(gate)] (st1) {};
\node[lab,anchor=west] at ([xshift=3mm]st1.north west) {阶段一：等背景受控竞争上下文下的双块载荷构造};
\draw[arr] (input.south) -- ++(0,-4mm) -| (s1.north);
\draw[arr] (s1.east) -- (s2.west);
\draw[arr] (s2.east) -- (s3.west);
\draw[arr] (s3.south) -- (s3.south |- gate.north);
\draw[arr,dashed] (gate.west) -- ++(-3mm,0) |- node[pos=0.25,left,font=\scriptsize,rotate=90,anchor=south]{按分项判据修订} (s1.west);
% 冻结与初始化
\node[wide,below=12mm of gate] (freeze) {冻结核心载荷$(\mathcal P_A,\mathcal P_B)$与外围语义垫片$(\mathcal S_A,\mathcal S_B)$，设定联合召回排名阈值$\tau_q=s(q,d_{(K-1)})$};
\draw[arr] (gate.south) -- node[right,font=\scriptsize]{通过} (freeze.north);
% 阶段二
\node[box,below=12mm of freeze] (t2) {跨视图检索损失$\mathcal L_{\mathrm{rob}}$\\存活权重加权间隔损失\\凹截断惩罚与波动抑制};
\node[box,left=6mm of t2] (t1) {对称双副本触发器布局\\前后垫片对称植入定长触发器\\防切块边界截断};
\node[box,right=6mm of t2] (t3) {双块交替坐标梯度搜索\\瓶颈块优先、一阶梯度提议\\词法约束与局部流畅度正则};
\node[stage,fit=(t1)(t3)] (st2) {};
\node[lab,anchor=west] at ([xshift=3mm]st2.north west) {阶段二：分块感知的检索触发器优化};
\draw[arr] (freeze.south) -- ++(0,-4mm) -| (t1.north);
\draw[arr] (t1.east) -- (t2.west);
\draw[arr] (t2.east) -- (t3.west);
% 输出与受害者处理链路
\node[wide,below=10mm of st2] (out) {将优化后段落$P_A(\mathbf t_A),P_B(\mathbf t_B)$植入槽位$(k_A,k_B)$，组装投毒源文档$D_{\mathrm{adv}}$};
\node[wide,below=6mm of out] (victim) {受害者评估链路：替换摄入$\rightarrow$受害者分块$\phi_v$$\rightarrow$自然Top-$K$检索与消融对照$\rightarrow$评估目标命中率ASR与迁移差$\Delta_{\mathrm{gen}}$};
\draw[arr] (t3.south) -- ++(0,-6.5mm) -| (out.north);
\draw[arr] (out.south) -- (victim.north);
\end{tikzpicture}