% 研究点一：两阶段解耦的跨块组合式投毒攻击框架，黑白框图
\begin{tikzpicture}[
  font=\small,
  box/.style={draw=black,thick,fill=white,align=center,text width=44mm,minimum height=11mm,inner sep=3pt},
  wide/.style={draw=black,thick,fill=white,align=center,text width=144mm,minimum height=10mm,inner sep=3pt},
  stage/.style={draw=black,dashed,inner sep=4mm},
  lab/.style={font=\footnotesize\bfseries,fill=white,inner sep=1pt},
  arr/.style={-{Stealth[length=2mm]},thick,black}
]
\node[wide] (input) {输入：目标查询$q$、正确答案$y_{\mathrm{true}}$、目标答案$a^*$、可篡改的长源文档$D$、干净背景Top-$K$检索缓存};
% 阶段一
\node[box,below=12mm of input] (s2) {核心载荷与语义垫片\\$\mathcal P_A$：规则注入块\\$\mathcal P_B$：实例桥接块};
\node[box,left=6mm of s2] (s1) {槽位锚定与几何隔离\\段落分位点$\rho_A,\rho_B$\\核心载荷间距$\ge\gamma K_{\max}$};
\node[box,right=6mm of s2] (s3) {等容量受控竞争上下文\\单块替换$d_{(K)}$、双块替换\\$d_{(K-1)},d_{(K)}$（容量恒为$K$）};
\node[wide,below=6mm of s2] (gate) {受控组合生成判据$\mathcal V_{\mathrm{gen}}$：单块竞争上下文$C_{\mathrm{single}}^{(A)},C_{\mathrm{single}}^{(B)}$均不导出$a^*$\ \ $\land$\ \ 双块竞争上下文$C_{\mathrm{mix}}$导出$a^*$};
\node[stage,fit=(s1)(s3)(gate)] (st1) {};
\node[lab,anchor=west] at ([xshift=3mm]st1.north west) {阶段一：受控竞争上下文下的双块载荷构造（生成可行性）};
\draw[arr] (input.south) -- ++(0,-4mm) -| (s1.north);
\draw[arr] (s1.east) -- (s2.west);
\draw[arr] (s2.east) -- (s3.west);
\draw[arr] (s3.south) -- (s3.south |- gate.north);
\draw[arr,dashed] (gate.west) -- ++(-3mm,0) |- node[pos=0.25,left,font=\scriptsize,rotate=90,anchor=south]{未通过则修订} (s1.west);
% 冻结与初始化
\node[wide,below=12mm of gate] (freeze) {冻结核心载荷$(\mathcal P_A,\mathcal P_B)$与外围语义垫片$(\mathcal S_A,\mathcal S_B)$\quad DoC2Query初始化边界触发器并设定竞争阈值$\tau_q=s(q,d_{(K-1)})$};
\draw[arr] (gate.south) -- node[right,font=\scriptsize]{通过} (freeze.north);
% 阶段二
\node[box,below=12mm of freeze] (t2) {分块鲁棒检索损失$\mathcal L_{\mathrm{rob}}$\\凹幂次截断惩罚$1-w(\xi)^p$\\跨尺寸与相位期望优化};
\node[box,left=6mm of t2] (t1) {多副本触发器布局\\语义垫片自然句边界处\\插入$R$个定长触发器$\mathbf t_j$};
\node[box,right=6mm of t2] (t3) {预算受限交替坐标搜索\\瓶颈块优先、一阶提议\\词法检查与局部流畅度};
\node[stage,fit=(t1)(t3)] (st2) {};
\node[lab,anchor=west] at ([xshift=3mm]st2.north west) {阶段二：分块感知的检索触发器优化（检索可达性）};
\draw[arr] (freeze.south) -- ++(0,-4mm) -| (t1.north);
\draw[arr] (t1.east) -- (t2.west);
\draw[arr] (t2.east) -- (t3.west);
% 输出与受害者处理链路
\node[wide,below=10mm of st2] (out) {组装单一投毒源文档$D_{\mathrm{adv}}$并经参考分块器$\phi_s$全文重切分，复核角色完整保持率、联合召回$H_R$与组合判据$\mathcal V_{\mathrm{gen}}$};
\node[wide,below=6mm of out] (victim) {受害者处理链路：替换摄入$\rightarrow$受害者侧分块$\phi_v$$\rightarrow$Top-$K$检索（$c_A,c_B$联合召回）$\rightarrow$生成目标答案$a^*$};
\draw[arr] (t3.south) -- ++(0,-6.5mm) -| (out.north);
\draw[arr] (out.south) -- (victim.north);
\end{tikzpicture}